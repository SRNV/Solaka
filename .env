# Origines CORS autorisées — dev local
# Ajoute ton IP réseau pour accéder depuis un téléphone (même Wi-Fi)
CORS_ORIGINS=http://localhost:5173,http://192.168.1.188:5173

# Hostname utilisé pour les QR codes (doit être l'adresse accessible par le téléphone)
# En production : https://ton-domaine.com
VITE_GAME_HOST=http://192.168.1.188:5173

# URL WebSocket du games-server — laisser vide pour utiliser ws://<hostname>:5000/stomp auto
# (fonctionne pour localhost ET accès réseau depuis téléphone)
# En production : wss://ton-domaine.com/stomp (ou le path configuré sur ton reverse proxy)
VITE_GAMES_STOMP_URL=
